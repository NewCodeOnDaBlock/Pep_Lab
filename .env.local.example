# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sign up free at https://resend.com — get your API key from the dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where order confirmation emails go TO (your business inbox)
ORDER_NOTIFICATION_EMAIL=orders@yourdomain.com

# "From" address — must match a verified Resend domain
EMAIL_FROM=noreply@yourdomain.com

# ─── Store ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=PepLab Research
NEXT_PUBLIC_STORE_URL=https://peplab.netlify.app

# ─── Admin CMS ───────────────────────────────────────────────────────────────
# Password to access /admin — set this in Netlify env vars too
ADMIN_PASSWORD=your-secure-admin-password-here

# ─── Sanity CMS ───────────────────────────────────────────────────────────────
# 1. Go to https://sanity.io → create a free account + new project
# 2. Copy your Project ID from the Sanity dashboard
# 3. Create an API token (Settings → API → Tokens → "Editor" role)
# 4. Add these three vars to Netlify env vars as well
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=sk...your-token-here

# ─── (Optional) Dropshipper webhook ──────────────────────────────────────────
# If your dropship partner exposes an API, add their endpoint + key here
DROPSHIP_WEBHOOK_URL=
DROPSHIP_API_KEY=
