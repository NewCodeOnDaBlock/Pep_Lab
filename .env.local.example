# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sign up free at https://resend.com — get your API key from the dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where order confirmation emails go TO (your business inbox)
ORDER_NOTIFICATION_EMAIL=orders@yourdomain.com

# "From" address — must match a verified Resend domain
EMAIL_FROM=noreply@yourdomain.com

# ─── Store ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=PepLab Research
NEXT_PUBLIC_STORE_URL=https://peplab.netlify.app

# ─── (Optional) Dropshipper webhook ──────────────────────────────────────────
# If your dropship partner exposes an API, add their endpoint + key here
DROPSHIP_WEBHOOK_URL=
DROPSHIP_API_KEY=
